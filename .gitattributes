# Auto-detect text files and normalize line endings to LF
* text=auto eol=lf

# Explicit text file handling
*.ts text eol=lf
*.js text eol=lf
*.json text eol=lf
*.md text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.py text eol=lf

# Binary files
*.png binary
*.jpg binary
*.ico binary
*.pdf binary
